{
  "sources": [
    {
      "name": "ventas",
      "enabled": true,

      "source": {
        "catalog": "electrocasa",
        "schema": "bronze",
        "table": "ventas_bronze"
      },

      "target": {
        "catalog": "electrocasa",
        "schema": "silver",
        "table": "ventas_silver"
      },

      "schema": {
        "venta_id": "string",
        "sucursal_id": "string",
        "producto_id": "string",
        "cantidad": "integer",
        "monto_total": "decimal(18,2)",
        "metodo_pago": "string",
        "fecha_venta": "date",
        "canal": "string",
        "updated_at": "timestamp"
      },

      "historization": {
        "type": 1,
        "keys": ["venta_id", "sucursal_id", "producto_id"],
        "sequence_by": "updated_at",
        "column_list": [
          "metodo_pago",
          "fecha_venta",
          "canal",
          "cantidad",
          "monto_total",
          "updated_at"
        ]
      },

      "expectations": {
        "warning_venta_id_null": "venta_id IS NOT NULL",
        "warning_sucursal_id_null": "sucursal_id IS NOT NULL",
        "warning_producto_id_null": "producto_id IS NOT NULL",
        "warning_monto_total_valido": "monto_total IS NOT NULL AND monto_total > 0",
        "warning_cantidad_valida": "cantidad IS NOT NULL AND cantidad > 0"
      },

       "properties": {
        "quality.layer": "silver",
        "quality.entity": "tracking",
        "quality.historization": "SCD1",
        "delta.autoOptimize.optimizeWrite": "true",
        "delta.autoOptimize.autoCompact": "true"
      },

      "quality_policy": {
        "warning_monto_total_valido": "quarantine"
      }
    },

    {
      "name": "productos",
      "enabled": true,

      "source": {
        "catalog": "electrocasa",
        "schema": "bronze",
        "table": "productos_bronze"
      },

      "target": {
        "catalog": "electrocasa",
        "schema": "silver",
        "table": "productos_silver"
      },

      "schema": {
        "producto_id": "string",
        "nombre_producto": "string",
        "categoria": "string",
        "marca": "string",
        "precio_lista": "decimal(18,2)",
        "updated_at": "timestamp"
      },

      "historization": {
        "type": 1,
        "keys": ["producto_id"],
        "sequence_by": "updated_at",
        "column_list": [
          "nombre_producto",
          "categoria",
          "marca",
          "precio_lista",
          "updated_at"
        ]
      },

      "expectations": {
        "warning_producto_id_null": "producto_id IS NOT NULL",
        "warning_nombre_producto_null": "nombre_producto IS NOT NULL",
        "warning_precio_lista_valido": "precio_lista IS NOT NULL AND precio_lista > 0"
      },

       "properties": {
        "quality.layer": "silver",
        "quality.entity": "tracking",
        "quality.historization": "SCD1",
        "pipelines.reset.allowed": "true",
        "delta.appendOnly": "false",
        "delta.autoOptimize.optimizeWrite": "true",
        "delta.autoOptimize.autoCompact": "true"
      },

      "quality_policy": {
        "warning_precio_lista_valido": "quarantine"
      }
    },

    {
      "name": "empleados",
      "enabled": true,

      "source": {
        "catalog": "electrocasa",
        "schema": "bronze",
        "table": "empleados_bronze"
      },

      "target": {
        "catalog": "electrocasa",
        "schema": "silver",
        "table": "empleados_silver"
      },

      "schema": {
        "id_empleado": "string",
        "nombre": "string",
        "dni": "string",
        "email": "string",
        "salario": "decimal(18,2)",
        "sucursal_id": "string",
        "cargo": "string",
        "tipo_evento": "string",
        "fecha_evento": "date",
        "updated_at": "timestamp",
        "__START_AT": "timestamp",
        "__END_AT": "timestamp"
      },

      "historization": {
        "type": 2,
        "keys": [
            "id_empleado",
            "fecha_evento",
            "tipo_evento"
          ],
        "sequence_by": "updated_at",
        "track_history_column_list": [
          "nombre",
          "dni",
          "email",
          "salario",
          "sucursal_id",
          "cargo",
          "updated_at"
        ]
      },

      "expectations": {
        "warning_id_empleado_null": "id_empleado IS NOT NULL",
        "warning_dni_null": "dni IS NOT NULL",
        "warning_fecha_evento_valida": "fecha_evento IS NOT NULL",
        "warning_tipo_evento_valido": "tipo_evento IN ('alta', 'transferencia', 'cambio_salario', 'baja')"
      },

       "properties": {
        "quality.layer": "silver",
        "quality.entity": "tracking",
        "quality.historization": "SCD2",
        "delta.autoOptimize.optimizeWrite": "true",
        "delta.autoOptimize.autoCompact": "true"
      },

      "quality_policy": {
        "warning_dni_null": "quarantine",
        "warning_fecha_evento_valida": "quarantine"
      }

    },

    {
      "name": "resenas",
      "enabled": true,

      "source": {
        "catalog": "electrocasa",
        "schema": "bronze",
        "table": "resenas_bronze"
      },

