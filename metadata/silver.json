      },

       "properties": {
        "quality.layer": "silver",
        "quality.entity": "tracking",
        "quality.historization": "SCD1",
        "delta.autoOptimize.optimizeWrite": "true",
        "delta.autoOptimize.autoCompact": "true"
      },

      "quality_policy": {
