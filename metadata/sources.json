{
  "sources": [
    {
      "name": "ventas",
      "enabled": true,
      "source_type": "file",
      "ingestion_method": "autoloader",
      "format": "csv",

      "landing_path": "/Volumes/electrocasa/bronze/landing/ventas/",

      "target": {
        "catalog": "electrocasa",
        "schema": "bronze",
        "table": "ventas_bronze"
      },

      "options": {
        "header": "true",
        "delimiter": ",",
        "inferSchema": "false"
      },

      "schema": {
        "venta_id": "string",
        "sucursal_id": "string",
        "producto_id": "string",
        "cantidad": "integer",
        "monto_total": "decimal(18,2)",
        "metodo_pago": "string",
        "fecha_venta": "string",
        "canal": "string"
      }
    },

