    {
      "name": "tracking",
      "enabled": true,
      "source_type": "azure_sql",
      "ingestion_method": "jdbc",

      "options": {
        "url": "jdbc:sqlserver://server-db-tracking.database.windows.net:1433;database=db-databricks-tracking;encrypt=true;trustServerCertificate=false;",
        "query": "SELECT tracking_id, pedido_id, courier, estado_entrega, sucursal_origen, CAST(fecha_actualizacion AS VARCHAR(255)) AS fecha_actualizacion FROM dbo.TrackingEnvios",
        "user": "sqladmin",
        "password": "mdp123$$"
      },

      "target": {
        "catalog": "electrocasa",
        "schema": "bronze",
        "table": "tracking_bronze"
      },

      "schema": {
        "tracking_id": "string",
        "pedido_id": "string",
        "courier": "string",
        "estado_entrega": "string",
        "sucursal_origen": "string",
